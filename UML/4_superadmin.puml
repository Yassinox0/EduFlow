@startuml SuperAdmin
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam shadowing false
skinparam linetype ortho
skinparam nodesep 40
skinparam ranksep 50
skinparam usecase {
  BackgroundColor #EDE7F6
  BorderColor #4527A0
  FontSize 12
}
skinparam actor {
  BackgroundColor #D1C4E9
  BorderColor #4527A0
  FontColor #311B92
}
skinparam package {
  BackgroundColor #F3E5F5
  BorderColor #6A1B9A
}

left to right direction

actor "Super Admin" as SA

rectangle "EduFlow — Espace Super Admin" {
  package "Espace École (hérité)" {
    package "Dashboard & Élèves" {
      usecase "Dashboard école" as UC_DashSchool
      usecase "Consulter élèves" as UC_ViewStudents
      usecase "Créer élève" as UC_CreateStudent
      usecase "Modifier élève" as UC_UpdateStudent
      usecase "Gérer classes" as UC_Classes
    }
    package "Paiements" {
      usecase "Mensualités" as UC_MonthlyFees
      usecase "Impayés" as UC_Unpaid
      usecase "Enregistrer paiement" as UC_CreatePayment
      usecase "Consulter paiements" as UC_ViewPayments
      usecase "Moyens de paiement" as UC_PaymentMethods
      usecase "Résumé parents" as UC_ParentSummary
    }
    package "Utilisateurs École" {
      usecase "Consulter utilisateurs école" as UC_ViewUsersSchool
      usecase "Créer utilisateur école" as UC_CreateUserSchool
      usecase "Modifier utilisateur école" as UC_UpdateUserSchool
    }
  }
  package "Espace Global (exclusif)" {
    package "Gestion Écoles" {
      usecase "Dashboard global" as UC_DashGlobal
      usecase "Consulter écoles" as UC_ViewSchools
      usecase "Créer école" as UC_CreateSchool
      usecase "Modifier école" as UC_UpdateSchool
      usecase "Créer admin école" as UC_CreateSchoolAdmin
      usecase "Uploader logo" as UC_UploadLogo
    }
    package "Utilisateurs Globaux" {
      usecase "Consulter utilisateurs globaux" as UC_ViewUsersGlobal
      usecase "Créer utilisateur global" as UC_CreateUserGlobal
      usecase "Modifier utilisateur global" as UC_UpdateUserGlobal
    }
  }
  package "Infrastructure" #FFFDE7 {
    usecase "Authentifier JWT" as UC_JWT
    usecase "Contrôler rôle" as UC_Role
    usecase "Accéder MySQL" as UC_DB
  }
}

